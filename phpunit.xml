<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
          PHP's 128M default is not enough to run the whole suite in one process
          now that some of it reads and writes XLSX. PhpSpreadsheet holds an
          entire workbook in memory and does not give all of it back, so the
          Intuitivo tests exhausted the limit somewhere past the eight hundredth
          test — not because any single test is heavy, but because they arrive
          last. Raised for the test process only; nothing about production
          changes, and Larastan already runs at 1G for the same kind of reason.

          768M since 0.163.0: the whole suite in one process already peaked at
          510 MB (6028 tests) and reached 512 MB with the usage-metrics tests
          (6048), measured without a limit — growth of the suite, not a leak —
          and failed at the very end, writing the result cache.
        -->
        <ini name="memory_limit" value="768M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
