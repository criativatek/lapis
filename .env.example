APP_NAME=LAPIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lapis.test

# O endereço público do site — canonical, Open Graph, sitemap e a linha
# Sitemap: do robots.txt. Distinto de APP_URL, que é para onde o email
# transacional envia as pessoas. Vazio = usa o host do pedido, que é o certo
# num site servido num só domínio.
LAPIS_PUBLIC_URL=

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Europe/Lisbon

# Voluntary self-service Pro trial (see config/trial.php).
TRIAL_PRO_DAYS=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL via DBngin. See docs/setup-local.md. Real credentials live only in .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=lapis
DB_USERNAME=lapis_local
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Apoio à redação nos Relatórios (opcional).
#
# Desligado por omissão, e o módulo Relatórios funciona inteiramente sem isto.
# A IA só reescreve texto que o LÁPIS já escreveu — nunca é fonte de facto.
#
# LAPIS_AI_DRIVER: vazio (desligado) | chat-completions | fake (só fora de produção)
# LAPIS_AI_ENDPOINT: o URL completo de /chat/completions do motor que escolher,
#   incluindo um modelo alojado na própria escola. O LÁPIS não escolhe fornecedor.
LAPIS_AI_DRIVER=
LAPIS_AI_ENDPOINT=
LAPIS_AI_KEY=
LAPIS_AI_MODEL=
LAPIS_AI_TIMEOUT=20
LAPIS_AI_MAX_CHARACTERS=6000
LAPIS_AI_PER_MINUTE=10
LAPIS_AI_ORGANIZATION_PER_MINUTE=40
