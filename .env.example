APP_NAME=Lapispro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lapis.test

# O endereço público do site — canonical, Open Graph, sitemap e a linha
# Sitemap: do robots.txt. Distinto de APP_URL, que é para onde o email
# transacional envia as pessoas. Vazio = usa o host do pedido, que é o certo
# num site servido num só domínio.
LAPIS_PUBLIC_URL=

# Identidade do responsavel pelo tratamento (RGPD) e contactos oficiais.
# Os valores reais sao defaults em config/lapis.php — sao um facto sobre o
# produto, nao configuracao por ambiente. Estas variaveis existem so para
# quem precise de os sobrepor. NUNCA preencher com um exemplo.
LAPIS_LEGAL_CONTROLLER_NAME=
LAPIS_LEGAL_CONTROLLER_VAT=
LAPIS_LEGAL_CONTROLLER_ADDRESS=
LAPIS_LEGAL_PRIVACY_EMAIL=
LAPIS_LEGAL_SUPPORT_EMAIL=
LAPIS_LEGAL_ACCOUNTS_EMAIL=

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Europe/Lisbon

# Voluntary self-service Pro trial (see config/trial.php).
TRIAL_PRO_DAYS=30

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL via DBngin. See docs/setup-local.md. Real credentials live only in .env.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lapis
DB_USERNAME=lapis_local
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Inteligência Artificial (opcional).
#
# Desligada por omissão, e toda a aplicação funciona inteiramente nesse estado.
# A IA reescreve ou comenta texto — nunca é fonte de facto (ADR-0006).
#
# ESTAS VARIÁVEIS SÃO O FUNDO, NÃO O TOPO. O que estiver guardado em
# platform_settings (Admin → Inteligência Artificial) sobrepõe-se a isto ao
# arranque; o que lá não estiver cai para aqui. Uma instalação que só use o .env
# comporta-se exatamente como antes de o painel existir.
#
# LAPIS_AI_DRIVER: vazio (desligado) | gemini | chat-completions | fake (só fora de produção)
# LAPIS_AI_ENDPOINT: só para chat-completions — o URL completo do endpoint do
#   motor que escolher, incluindo um modelo alojado na própria escola.
LAPIS_AI_DRIVER=
LAPIS_AI_ENDPOINT=
LAPIS_AI_MODEL=

# A CHAVE. Em produção prefira um gestor de segredos externo que injete esta
# variável no deploy, e deixe a credencial do painel por configurar — uma coluna
# cifrada na base de dados só é tão forte quanto a APP_KEY que a decifra, e a
# APP_KEY vive no mesmo ficheiro, na mesma máquina.
LAPIS_AI_KEY=

LAPIS_AI_TIMEOUT=20
LAPIS_AI_MAX_CHARACTERS=6000
LAPIS_AI_MAX_OUTPUT_TOKENS=2048
# Teto absoluto e duro: nenhuma chamada recebe mais do que isto, nem quando um
# caso de uso pede um orçamento maior (ver AiUseCase::minimumOutputTokens()).
# LAPIS_AI_MAX_OUTPUT_TOKENS acima é a PREDEFINIÇÃO, não o máximo — uma
# funcionalidade que declare precisar de mais sobe acima dela, nunca acima deste
# teto. Se este teto ficar abaixo de um mínimo declarado (a síntese de
# acompanhamento pede 3072), essa funcionalidade passa a recusar de forma
# explícita em vez de enviar um valor que não pode funcionar.
LAPIS_AI_MAX_OUTPUT_TOKENS_CEILING=8192
LAPIS_AI_PER_MINUTE=10
LAPIS_AI_ORGANIZATION_PER_MINUTE=40

# Base da API do Gemini. Configurável para um deployment regional ou por proxy.
LAPIS_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Modelos a tentar, por ordem, quando o configurado responde 404 (retirado),
# 429 (quota) ou 503 (sem capacidade). Vazio = sem recurso. Nao ha predefinicao
# util: um nome de modelo apodrece sem aviso, e cada instalacao declara o que
# verificou. Separados por virgula.
LAPIS_AI_GEMINI_FALLBACK_MODELS=

# Tetos TÉCNICOS de custo por capability. Não são a quota comercial de um plano
# — essa é uma decisão por tomar (ver docs/ai-core-contract.md). Em branco
# significa sem teto; 0 significa a capability fechada.
LAPIS_AI_HELP_USER_DAILY=60
LAPIS_AI_HELP_ORGANIZATION_MONTHLY=3000
LAPIS_AI_PEDAGOGICAL_USER_DAILY=40
LAPIS_AI_PEDAGOGICAL_ORGANIZATION_MONTHLY=1500

# Faturação — transferência bancária (ver config/billing.php).
# O IBAN vive aqui e não na base de dados: mudá-lo exige acesso ao servidor.
BILLING_BANK_BENEFICIARY=
BILLING_BANK_IBAN=
BILLING_BANK_BIC=

# Exportar um reporte para um rastreador externo. VAZIO = DESLIGADO, e e essa a
# predefinicao: exportar tira o reporte do relogio de retencao que a Politica de
# Privacidade promete. Ler docs/adr/0013-issue-export.md antes de preencher, e
# so com um repositorio PRIVADO.
LAPIS_SUPPORT_GITHUB_TOKEN=
LAPIS_SUPPORT_GITHUB_REPOSITORY=
