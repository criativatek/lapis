APP_NAME=Lapispro
APP_ENV=testing
APP_KEY=  # gerar com: php artisan key:generate --env=testing
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=pt_PT
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Europe/Lisbon

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A database of its own, on the same DBngin service. NEVER `lapis` — the
# development database — and never anything reachable in production: the
# commands that point here (`migrate:fresh --env=testing`) drop every table
# first, so the name is the only thing standing between a rehearsal and losing
# a week of local work.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=lapis_testing
DB_USERNAME=root
DB_PASSWORD=

# Nothing that outlives the run, and nothing that leaves the machine.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

# No mail leaves this environment: `array` keeps every message in memory for
# assertions and hands nothing to a transport.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="testing@lapis.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
