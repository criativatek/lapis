* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Import fixtures are exact byte-for-byte reproductions of what other platforms
# export: a BOM, CRLF line endings, quoted fields. `text=auto eol=lf` above would
# normalise exactly the things the parser tests exist to prove it survives, so
# the tests would still pass while no longer testing anything.
tests/Fixtures/Import/** -text

# The Pauta's CSV and Excel as they were written before their cell text was
# shared (BOM, quoted fields): characterization files, compared byte for byte.
tests/Fixtures/EvaluationSheet/** -text

# Frozen props of the Base pages as they were before the advanced analysis (D0):
# characterization files, compared byte for byte.
tests/Fixtures/AdvancedAnalysis/** -text

CHANGELOG.md export-ignore
README.md export-ignore
.github/workflows/browser-tests.yml export-ignore
